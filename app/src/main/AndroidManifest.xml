        <!-- Cross-app notification read special access only. Not posting, not a run/model grant.
             No separate process: uses the application-owned capture store and listener gate. -->
        <service android:name=".platform.CrossAppNotificationListener"
            android:label="跨应用通知读取（独立授权）"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Only Android may bind this service; enabling it is an explicit system-settings action. -->
