buffers { size_kb: 65536 fill_policy: RING_BUFFER }
buffers { size_kb: 4096 fill_policy: RING_BUFFER }
duration_ms: 900000
write_into_file: false
trigger_config {
  trigger_mode: STOP_TRACING
  trigger_timeout_ms: 900000
  triggers { name: "daiyu_ui_jank_v1" stop_delay_ms: 2000 }
}
data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "wm"
      atrace_categories: "am"
      atrace_categories: "dalvik"
      atrace_categories: "input"
      atrace_apps: "app.daiyu.android"
      compact_sched { enabled: true }
      drain_period_ms: 250
    }
  }
}
data_sources {
  config { name: "linux.process_stats" target_buffer: 1
    process_stats_config { scan_all_processes_on_start: true proc_stats_poll_ms: 1000 } }
}
data_sources {
  config { name: "android.packages_list" target_buffer: 1
    packages_list_config { package_name_filter: "app.daiyu.android" } }
}
data_sources { config { name: "android.surfaceflinger.frametimeline" target_buffer: 0 } }
incremental_state_config { clear_period_ms: 5000 }
